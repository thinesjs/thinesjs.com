{
  "name": "thinesjs",
  "private": true,
  "version": "0.2.14",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "release": "commit-and-tag-version",
    "release:prod": "commit-and-tag-version --tag-prefix=release-v",
    "release:dry:prod": "commit-and-tag-version --dry-run --tag-prefix=v",
    "init:prod": "SLS_DEBUG=* sls create-cert --stage production",
    "sls-deploy-production": "sls deploy -s production",
    "deploy-client:production": "sls client deploy --stage production --no-config-change --no-policy-change --no-confirm",
    "deploy": "yarn build && yarn deploy-client:production"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.3",
    "astro": "^7.2.9",
    "commit-and-tag-version": "^12.5.1",
    "tailwindcss": "^4.1.3"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
